{
	"name": "ella-ai-transcriber",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"typecheck": "pnpm check:types",
		"format": "biome check --write",
		"check:secrets": "secretlint",
		"check:format": "biome check --error-on-warnings",
		"check:types": "tsc --noEmit",
		"check:lint": "eslint --max-warnings 0",
		"check:duplication": "jscpd --silent",
		"check:duplication:tests": "jscpd --silent --config .jscpd.tests.json",
		"check:tests": "vitest --run --coverage --passWithNoTests",
		"check": "pnpm check:secrets \"**/*\" && pnpm check:format . && pnpm check:types && pnpm check:lint . && pnpm check:duplication && pnpm check:duplication:tests && pnpm check:tests",
		"lint": "pnpm check",
		"audit:constants": "node scripts/audit-constants.mjs src",
		"setup": "./scripts/setup"
	},
	"dependencies": {
		"@elevenlabs/elevenlabs-js": "^2.57.0",
		"@inquirer/prompts": "^7.5.2",
		"canvas": "^3.2.3",
		"chrono-node": "^2.10.0",
		"cli-progress": "^3.12.0",
		"dotenv": "^16.5.0",
		"fluent-ffmpeg": "^2.1.3",
		"openai": "^6.46.0",
		"pdfjs-dist": "^6.1.200",
		"pino": "^10.3.1",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
		"@types/cli-progress": "^3.11.6",
		"@types/fluent-ffmpeg": "^2.1.28",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/eslint-plugin": "^1.6.23",
		"eslint": "^10.7.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"jscpd": "^5.0.12",
		"nock": "^14.0.16",
		"secretlint": "^13.0.2",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.10"
	}
}
