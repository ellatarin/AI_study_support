{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"outDir": "dist",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"allowJs": true
	},
	"include": ["src", "vitest.config.ts", "eslint.config.js", "scripts"]
}
