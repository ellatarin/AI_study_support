#!/usr/bin/env bash
# lecture-notes CLI wrapper.
# Runs live TypeScript via tsx (no build step). Invocable from any directory
# once setup has put bin/ on PATH, but it changes to the repo root before
# running, so a relative path given as an argument — `--module ./Biology` — is
# resolved against the repo and not against the caller's working directory.
# Give module paths in absolute form, as pipeline-config.json does.
# See docs/technical-design.md §4.7 and docs/implementation-plan.md Phase 3.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/repo-root.sh"
cd "$repo_root"
exec pnpm exec tsx src/index.ts "$@"
