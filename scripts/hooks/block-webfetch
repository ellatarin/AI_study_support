#!/usr/bin/env bash
# PreToolUse hook for WebFetch and WebSearch.
# Both fetch whole pages and bloat context; tavily is the sanctioned route.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Resolved from the script's own location, not the working directory — the
# relative path this used to use silently did nothing whenever a session ran
# from anywhere but the repo root.
if node "$repo_root/scripts/hooks/lib/tool-override.mjs"; then
  exit 0
fi

echo "BLOCKED: WebFetch and WebSearch fetch entire pages and bloat context. Use tavily MCP tools instead:" >&2
echo "  - tavily_search   → find information on the web" >&2
echo "  - tavily_extract  → extract content from a specific URL" >&2
echo "  - tavily_research → deep multi-step research" >&2
echo "" >&2
echo "Override is legitimate when:" >&2
echo "  - The URL is not a webpage (e.g. raw JSON/YAML spec, binary, non-crawlable resource)" >&2
echo "  - tavily_extract already failed on this URL" >&2
echo "" >&2
echo "To override: Write '.claude/tool-override' with your reason before this tool call." >&2
exit 2
