#!/usr/bin/env node
/*
 * PreToolUse hook for WebFetch and WebSearch.
 *
 * Both fetch whole pages and bloat context; tavily is the sanctioned route.
 *
 * Node rather than bash for the same reason block-grep is: the sentence telling
 * the reader how to override a block is one instruction, so it is read from
 * lib/search-guidance.mjs rather than written out here as well.
 */

import { OVERRIDE_HINT } from "./lib/search-guidance.mjs";
import { acceptOverride } from "./lib/tool-override.mjs";

if (acceptOverride()) {
	process.exit(0);
}

const message = [
	"BLOCKED: WebFetch and WebSearch fetch entire pages and bloat context. Use tavily MCP tools instead:",
	"  - tavily_search   → find information on the web",
	"  - tavily_extract  → extract content from a specific URL",
	"  - tavily_research → deep multi-step research",
	"",
	"Override is legitimate when:",
	"  - The URL is not a webpage (e.g. raw JSON/YAML spec, binary, non-crawlable resource)",
	"  - tavily_extract already failed on this URL",
	"",
	OVERRIDE_HINT,
].join("\n");

process.stderr.write(`${message}\n`);
process.exit(2);
