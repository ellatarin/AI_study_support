#!/usr/bin/env node
/*
 * PreToolUse hook for the Grep tool.
 *
 * Blocks it outright: raw file matches lead to Read chains that bloat context.
 *
 * Node rather than bash, following block-bash-grep: what this prints has to be
 * the same guidance the Bash blocker prints, and the only way two hooks say one
 * thing is by reading it from one place — lib/search-guidance.mjs. Being node
 * also means it reaches lib/tool-override.mjs by import rather than by spawning
 * it, so this file needs no notion of where the repo root is.
 */

import { OVERRIDE_HINT, VERA_ALTERNATIVES } from "./lib/search-guidance.mjs";
import { acceptOverride } from "./lib/tool-override.mjs";

if (acceptOverride()) {
	process.exit(0);
}

const message = [
	"BLOCKED: The Grep tool returns raw file matches and leads to Read chains that bloat context.",
	"",
	...VERA_ALTERNATIVES,
	"",
	"If the Vera index is missing: run `vera index .` then retry.",
	"",
	OVERRIDE_HINT,
].join("\n");

process.stderr.write(`${message}\n`);
process.exit(2);
