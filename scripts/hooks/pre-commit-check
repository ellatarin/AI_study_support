#!/usr/bin/env bash
# PreToolUse hook for Bash calls that look like `git commit`.
# Runs the mechanical commit-time checks; on any failure, exits with a
# non-zero code that Claude Code treats as "block the tool call".
#
# NOTE: Claude Code passes the tool call as JSON on stdin. Blocking behaviour
# and the exact exit-code contract should be verified against the current
# Claude Code docs. This script exits 2 on check failure (the widely-used
# "block-and-inform" convention for PreToolUse hooks).
#
# IMPORTANT: this is a PreToolUse hook, so it fires BEFORE the `git commit`
# command runs — which means before any `git add` in the same command line has
# executed. It therefore checks the WORKING TREE (files that differ from HEAD,
# staged or not, plus untracked files), never the index. Checking the index
# would silently skip everything when files are staged and committed in a single
# `git add X && git commit` step.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Read the hook payload here, first thing, and pass it on explicitly. Leaving it
# on stdin for the classifier to collect did not work: bash receives the payload
# but the child process found stdin already empty, so every command looked
# unclassifiable. The `-t 5` keeps a missing payload from hanging the tool call.
payload=""
IFS= read -r -d '' -t 5 payload || true

# Only trigger on a commit; anything else passes through unblocked. The
# classification is lib/is-git-commit.mjs, which parses the command rather than
# looking for the substring "git commit" — that test let `git -C . commit` and
# `git -c user.name=x commit` skip secretlint, Biome, tsc, ESLint, both jscpd
# passes and the whole suite.
#
# Exit 10 means "not a commit". Any other non-zero means the classifier itself
# failed, and the checks run regardless: a gate that waves commits through when
# it cannot tell is the failure being fixed here, not an acceptable fallback.
set +e
printf '%s' "$payload" | node "$repo_root/scripts/hooks/lib/is-git-commit.mjs"
trigger_status=$?
set -e

if [ "$trigger_status" -eq 10 ]; then
  exit 0
fi
if [ "$trigger_status" -ne 0 ]; then
  echo "pre-commit-check: could not classify this command (exit $trigger_status); running the checks anyway." >&2
fi

cd "$repo_root"

# Collect files that differ from HEAD in the WORKING TREE, regardless of whether
# they have been `git add`ed: tracked modifications/additions (git diff HEAD)
# plus untracked new files (git ls-files --others). This makes the gate robust
# to staging order — see the header note.
changed_any="$( { git diff HEAD --name-only --diff-filter=ACM; git ls-files --others --exclude-standard; } 2>/dev/null | sort -u || true)"
# Two different sets, because the two tools cover different things. Biome reads
# JSON and does not read Markdown — handing it a .md file makes the whole run
# fail with "no files were processed", which is why .md is absent here rather
# than merely harmless. ESLint reads every code file, JavaScript included:
# eslint.config.js, vitest.config.ts and scripts/*.mjs are all in its scope.
changed_biome="$(echo "$changed_any" | grep -E '\.(ts|tsx|js|mjs|cjs|jsx|json|jsonc)$' || true)"
changed_code="$(echo "$changed_any" | grep -E '\.(ts|tsx|js|mjs|cjs)$' || true)"

fail() {
  # Print the reason for the block to stderr; Claude Code surfaces stderr
  # in the assistant's next turn when a PreToolUse hook returns non-zero.
  echo "$*" >&2
  exit 2
}

# Every check below runs through its package.json script rather than spelling
# out the tool and its flags here. That is what makes `pnpm check` and this hook
# the same gate: they differ only in scope — the hook narrows the file-based
# checks to what changed, and `pnpm check` runs them over the tree.

# 0. secretlint — secret/credential detection on all changed files.
# Runs first because a leaked secret is the one class of bug where remediation
# after the commit lands is far more expensive than catching it here.
if [ -n "$changed_any" ]; then
  echo "$changed_any" | xargs pnpm run --silent check:secrets \
    || fail "secretlint detected potential secrets in changed files. Review, redact, and re-commit. If it is a genuine false positive, add an allowlist entry to .secretlintrc.json."
fi

# 1. biome — format + standard linting on changed files.
# No --no-errors-on-unmatched: biome.json now covers every path this filter can
# produce, so "provided but ignored" means the config has a hole, and the gate
# should say so rather than report success.
if [ -n "$changed_biome" ]; then
  echo "$changed_biome" | xargs pnpm run --silent check:format \
    || fail "biome check failed on changed files. Fix and re-commit."
fi

# 2. tsc — whole-project type check. Type errors span files, so no narrowing.
pnpm run --silent check:types \
  || fail "tsc --noEmit failed. Fix the type errors above and re-commit."

# 3. eslint — architectural rules on changed code files.
if [ -n "$changed_code" ]; then
  echo "$changed_code" | xargs pnpm run --silent check:lint \
    || fail "eslint failed on changed code files. Fix and re-commit."
fi

# 4. jscpd — copy-paste detection across the whole src/ tree.
# Whole-tree, not change-scoped: a new file may duplicate an existing one that
# was not itself changed. Config lives in .jscpd.json.
pnpm run --silent check:duplication \
  || fail "jscpd found duplicate code. See report above; extract into a shared helper and re-commit."

# 4b. jscpd — the same check over test files, which .jscpd.json excludes.
# Separate pass because jscpd takes one config per run, and tests need a higher
# minTokens (40 vs 20): the arrange/act/assert skeleton legitimately repeats at
# ~35 tokens, so a tighter floor would demand contorted tests. At 40 every hit
# has been a real extraction — a shared helper, a `beforeEach`, or a `test.each`.
# Raise minTokens in .jscpd.tests.json if it ever starts asking otherwise.
pnpm run --silent check:duplication:tests \
  || fail "jscpd found duplicate code in tests. Extract a helper, a beforeEach, or a test.each and re-commit."

# 5. vitest — full test suite with coverage, enforcing the thresholds in
# vitest.config.ts. --passWithNoTests avoids blocking if tests are ever absent.
pnpm run --silent check:tests \
  || fail "Tests failed or coverage dropped below threshold. Fix and re-commit."

# All checks passed; allow the commit to proceed.
exit 0
