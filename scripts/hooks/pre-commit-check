#!/usr/bin/env bash
# PreToolUse hook for Bash calls that look like `git commit`.
# Runs the mechanical commit-time checks; on any failure, exits with a
# non-zero code that Claude Code treats as "block the tool call".
#
# NOTE: Claude Code passes the tool call as JSON on stdin. Blocking behaviour
# and the exact exit-code contract should be verified against the current
# Claude Code docs. This script exits 2 on check failure (the widely-used
# "block-and-inform" convention for PreToolUse hooks).

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Parse tool input JSON, extract the bash command string.
bash_command="$(node -e '
  let s = "";
  process.stdin.on("data", d => (s += d));
  process.stdin.on("end", () => {
    try {
      const j = JSON.parse(s);
      const c = j.tool_input?.command ?? "";
      process.stdout.write(String(c));
    } catch {
      process.stdout.write("");
    }
  });
' 2>/dev/null || echo "")"

# Only trigger on `git commit`. Anything else passes through unblocked.
case "$bash_command" in
  *"git commit"*) : ;;
  *) exit 0 ;;
esac

cd "$repo_root"

# Collect staged files by category.
staged_any="$(git diff --cached --name-only --diff-filter=ACM || true)"
staged_all="$(echo "$staged_any" | grep -E '\.(ts|tsx|js|mjs|cjs|jsx|json|jsonc|md)$' || true)"
staged_ts="$(echo "$staged_any" | grep -E '\.(ts|tsx)$' || true)"

fail() {
  # Print the reason for the block to stderr; Claude Code surfaces stderr
  # in the assistant's next turn when a PreToolUse hook returns non-zero.
  echo "$*" >&2
  exit 2
}

# 0. secretlint — secret/credential detection on ALL staged files.
# Runs first because a leaked secret is the one class of bug where remediation
# after the commit lands is far more expensive than catching it here.
if [ -n "$staged_any" ]; then
  echo "$staged_any" | xargs pnpm exec secretlint \
    || fail "secretlint detected potential secrets in staged files. Review, redact, and re-commit. If it is a genuine false positive, add an allowlist entry to .secretlintrc.json."
fi

# 1. biome — format + standard linting on staged files.
if [ -n "$staged_all" ]; then
  echo "$staged_all" | xargs pnpm exec biome check --error-on-warnings \
    || fail "biome check failed on staged files. Fix and re-commit."
fi

# 2. tsc — whole-project type check. Type errors span files, so no staged narrowing.
pnpm exec tsc --noEmit \
  || fail "tsc --noEmit failed. Fix the type errors above and re-commit."

# 3. eslint — architectural rules on staged TS files.
if [ -n "$staged_ts" ]; then
  echo "$staged_ts" | xargs pnpm exec eslint \
    || fail "eslint failed on staged TypeScript files. Fix and re-commit."
fi

# 4. jscpd — copy-paste detection across the whole src/ tree.
# Whole-tree, not staged-only: a new file may duplicate an existing one that
# wasn't in the staged set. Config lives in .jscpd.json.
pnpm exec jscpd --silent \
  || fail "jscpd found duplicate code. See report above; extract into a shared helper and re-commit."

# 5. vitest — full test suite. --passWithNoTests avoids blocking during the
# pre-Phase-1 window when there are no tests yet.
pnpm exec vitest --run --passWithNoTests \
  || fail "Tests failed. Fix the failures above and re-commit."

# All checks passed; allow the commit to proceed.
exit 0
