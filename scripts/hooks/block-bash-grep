#!/usr/bin/env node
/*
 * PreToolUse hook for the Bash tool.
 *
 * Blocks searches over this repo's files, which must go through the Vera index
 * instead. The decision, the tool list and the message all live in
 * lib/search-block.mjs, where they are covered by tests and reached by the
 * linter — this file only wires stdin to it.
 */

import { readCommandFromStdin } from "./lib/hook-payload.mjs";
import { blockMessage, shouldBlockCommand } from "./lib/search-block.mjs";
import { acceptOverride } from "./lib/tool-override.mjs";

const payload = await readCommandFromStdin();
if (!payload.parsed || !payload.command.trim()) {
	process.exit(0);
}
if (!shouldBlockCommand(payload.command)) {
	process.exit(0);
}
if (acceptOverride()) {
	process.exit(0);
}
process.stderr.write(`${blockMessage()}\n`);
process.exit(2);
