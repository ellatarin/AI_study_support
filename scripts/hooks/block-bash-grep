#!/usr/bin/env node
/*
 * PreToolUse hook for the Bash tool.
 *
 * Blocks non-piped codebase searches (grep/egrep/fgrep, rg/ripgrep, git grep)
 * whose target resolves INSIDE this repo — the tree the Vera index covers.
 * Those searches must go through `vera grep` / `vera search` instead, which is
 * what the repo's Code Search policy requires.
 *
 * ALLOWED (exit 0):
 *   - piped searches:            `cat x | grep foo`   (reads stdin, not files)
 *   - targets outside the repo:  `grep foo /tmp/y`, `rg foo ~/.claude`
 *   - anything that isn't one of the covered search tools
 *
 * BLOCKED (exit 2, stderr fed back to the agent):
 *   - `grep -n foo docs/x.md`, `grep -r foo .`, `rg foo`, `git grep foo`
 *
 * Escape hatch: write `.claude/tool-override` with a one-line reason before the
 * command (consumed once) for a genuinely legitimate in-repo case — e.g. a file
 * type Vera does not index. The reason is visible in the transcript.
 *
 * Detection is heuristic and deliberately errs toward blocking. Known gaps:
 * command substitution `$(...)`/backticks are treated as fresh command
 * contexts; exotic constructs may slip through.
 */

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const scriptDir = path.dirname(fileURLToPath(import.meta.url));
const repoRoot = path.resolve(scriptDir, "..", "..");
const overrideFile = path.join(repoRoot, ".claude", "tool-override");
const home = process.env.HOME || process.env.USERPROFILE || "";

const SEARCH_TOOLS = new Set(["grep", "egrep", "fgrep", "rg", "ripgrep"]);

/** Read the entire hook payload from stdin. */
function readStdin() {
  return new Promise((resolve) => {
    let data = "";
    process.stdin.on("data", (chunk) => {
      data += chunk;
    });
    process.stdin.on("end", () => resolve(data));
  });
}

/** Split a command string into words and shell operators, respecting quotes. */
function lex(command) {
  const tokens = [];
  let current = "";
  let quote = null;
  const flush = () => {
    if (current !== "") {
      tokens.push({ kind: "word", value: current });
      current = "";
    }
  };
  for (let i = 0; i < command.length; i += 1) {
    const char = command[i];
    if (quote) {
      if (char === quote) {
        quote = null;
      } else {
        current += char;
      }
      continue;
    }
    if (char === '"' || char === "'") {
      quote = char;
      continue;
    }
    if (char === "\\") {
      current += command[i + 1] || "";
      i += 1;
      continue;
    }
    const pair = command.slice(i, i + 2);
    if (pair === "&&" || pair === "||") {
      flush();
      tokens.push({ kind: "sep" });
      i += 1;
      continue;
    }
    if (pair === "$(") {
      flush();
      tokens.push({ kind: "sep" });
      i += 1;
      continue;
    }
    if (char === "|") {
      flush();
      tokens.push({ kind: "pipe" });
      continue;
    }
    if (char === ";" || char === "\n" || char === "&" || char === "`" || char === "(" || char === ")") {
      flush();
      tokens.push({ kind: "sep" });
      continue;
    }
    if (char === " " || char === "\t" || char === "\r") {
      flush();
      continue;
    }
    current += char;
  }
  flush();
  return tokens;
}

/** Group lexed tokens into simple commands, tracking whether each reads a pipe. */
function toCommands(tokens) {
  const commands = [];
  let words = [];
  let pipedIn = false;
  const flush = () => {
    if (words.length) {
      commands.push({ words, pipedIn });
    }
    words = [];
  };
  for (const token of tokens) {
    if (token.kind === "word") {
      words.push(token.value);
      continue;
    }
    flush();
    pipedIn = token.kind === "pipe";
  }
  flush();
  return commands;
}

/** Strip leading `VAR=value` assignments and command prefixes like `sudo`. */
function stripPrefixes(words) {
  const rest = [...words];
  const prefixes = new Set(["sudo", "command", "time", "nice", "env"]);
  while (rest.length) {
    const head = rest[0];
    if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(head) || prefixes.has(head)) {
      rest.shift();
      continue;
    }
    break;
  }
  return rest;
}

/** Whether an argument path resolves to a location inside the repo tree. */
function isInsideRepo(argument) {
  let expanded = argument;
  if (expanded === "~") {
    expanded = home;
  } else if (expanded.startsWith("~/")) {
    expanded = path.join(home, expanded.slice(2));
  }
  const absolute = path.resolve(repoRoot, expanded);
  const relative = path.relative(repoRoot, absolute);
  return relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative));
}

/** Decide whether a single search command targets the repo and must be blocked. */
function shouldBlock(command) {
  const words = stripPrefixes(command.words);
  if (!words.length) {
    return false;
  }
  let tool = words[0];
  let args = words.slice(1);
  if (tool === "git") {
    if (args[0] !== "grep") {
      return false;
    }
    // git grep always searches the repository's tracked files.
    return true;
  }
  if (!SEARCH_TOOLS.has(tool)) {
    return false;
  }
  if (command.pipedIn) {
    // Reading from a pipe: not a file search over the codebase.
    return false;
  }
  const flags = args.filter((token) => token.startsWith("-") && token !== "-");
  const nonFlags = args.filter((token) => !token.startsWith("-") || token === "-");
  // First non-flag token is (heuristically) the pattern; the rest are paths.
  const paths = nonFlags.slice(1);
  const insidePaths = paths.filter((candidate) => isInsideRepo(candidate));
  const outsidePaths = paths.filter((candidate) => !isInsideRepo(candidate));
  const recursive = flags.some((flag) => /^-[A-Za-z]*[rR]/.test(flag) || flag === "--recursive");

  const isRipgrep = tool === "rg" || tool === "ripgrep";
  if (isRipgrep) {
    // ripgrep with no path searches the current directory recursively.
    if (paths.length === 0) {
      return true;
    }
    return insidePaths.length > 0 || outsidePaths.length === 0;
  }
  // grep family:
  if (insidePaths.length > 0) {
    return true;
  }
  if (recursive && outsidePaths.length === 0) {
    // `grep -r pattern` with no explicit path targets the current directory.
    return true;
  }
  return false;
}

function consumeOverride() {
  if (!fs.existsSync(overrideFile)) {
    return null;
  }
  let reason = "";
  try {
    reason = fs.readFileSync(overrideFile, "utf8").trim();
    fs.unlinkSync(overrideFile);
  } catch {
    return null;
  }
  return reason;
}

function blockMessage() {
  const lines = [
    "BLOCKED: searching files inside this repo with grep/rg/git grep bypasses the Vera index.",
    "",
    "Use Vera instead:",
    '  - vera search "describe behaviour"   → semantic/conceptual queries',
    '  - vera grep "exact pattern"          → regex, exact strings, imports, TODOs',
    "",
    "Piped searches (`... | grep`) and targets OUTSIDE the repo are allowed.",
    "For a genuine in-repo case Vera cannot cover (e.g. a non-indexed file type),",
    "write '.claude/tool-override' with a one-line reason before the command.",
  ];
  return lines.join("\n");
}

async function main() {
  let command = "";
  try {
    const payload = JSON.parse(await readStdin());
    command = String(payload?.tool_input?.command ?? "");
  } catch {
    process.exit(0);
  }
  if (!command.trim()) {
    process.exit(0);
  }
  // Fast path: nothing that looks like a covered search tool.
  if (!/\b(grep|egrep|fgrep|rg|ripgrep)\b/.test(command)) {
    process.exit(0);
  }

  const commands = toCommands(lex(command));
  const offending = commands.some((entry) => shouldBlock(entry));
  if (!offending) {
    process.exit(0);
  }

  const override = consumeOverride();
  if (override !== null) {
    process.stderr.write(`Override accepted: ${override}\n`);
    process.exit(0);
  }

  process.stderr.write(`${blockMessage()}\n`);
  process.exit(2);
}

main();
