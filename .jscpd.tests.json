{
	"threshold": 0,
	"reporters": ["console"],
	"absolute": true,
	"gitignore": true,
	"ignore": [
		"**/__fixtures__/**",
		"**/__snapshots__/**",
		"node_modules/**",
		"dist/**",
		".claude/**"
	],
	"pattern": "**/{*.test,*.integration.test,fixtures}.{ts,tsx,js,mjs}",
	"minTokens": 40,
	"minLines": 2,
	"format": ["typescript", "tsx", "javascript"]
}
