{
	"version": "1",
	"moduleRoots": ["/absolute/path/to/Biology of Disease", "/absolute/path/to/Anatomy"],
	"openRouter": {
		"baseUrl": "https://openrouter.ai/api/v1",
		"completionTimeoutMs": 120000,
		"completionMaxRetries": 5
	},
	"elevenLabs": {
		"baseUrl": "https://api.elevenlabs.io",
		"languageCode": "eng",
		"costPerAudioHourUsd": 0.22
	},
	"currency": {
		"gbpPerUsd": 0.74
	},
	"modelIdCheck": {
		"exemptProviders": ["elevenlabs"]
	},
	"naming": {
		"modulePrefixes": ["BOD", "Biology of Disease", "ANA"]
	},
	"division": {
		"panelSize": 18,
		"bar": 9,
		"sizeGateWords": 600
	},
	"grouping": {
		"panelSize": 5,
		"bar": 3
	},
	"batch": {
		"concurrency": 1
	},
	"stages": {
		"transcription": {
			"modelId": "elevenlabs/scribe_v2"
		},
		"initial-subtopic-splitting": {
			"modelId": "<FAST_LONG_CONTEXT_MODEL>",
			"concurrency": 3
		},
		"deepen-subtopic-splitting": {
			"modelId": "<FAST_LONG_CONTEXT_MODEL>",
			"concurrency": 6,
			"callConcurrency": 10
		},
		"retitle-subtopics": {
			"modelId": "<REASONING_MODEL>"
		},
		"define-topics": {
			"modelId": "<REASONING_MODEL>",
			"concurrency": 5,
			"sendGapSeconds": 0.5
		},
		"transcript-structuring": {
			"modelId": "<REASONING_MODEL>",
			"temperature": 0.2,
			"maxTokens": 8192
		},
		"transcript-verification": {
			"modelId": "<REASONING_MODEL>",
			"temperature": null,
			"maxTokens": null
		},
		"slide-conversion": {
			"modelId": "<COST_EFFICIENT_VISION_MODEL>",
			"temperature": 0.1,
			"maxTokens": 4096,
			"concurrency": 3
		},
		"image-extraction": {
			"modelId": "<PRECISION_VISION_MODEL>",
			"temperature": 0.0,
			"maxTokens": 2048,
			"concurrency": 2
		},
		"synthesis": {
			"modelId": "<REASONING_MODEL>",
			"temperature": 0.3,
			"maxTokens": 16384
		},
		"qa-loop": {
			"modelId": "<REASONING_MODEL>",
			"temperature": 0.1,
			"maxTokens": 8192,
			"maxIterations": 3
		}
	},
	"output": {
		"language": "en-GB",
		"pandocEngine": "xelatex"
	}
}
