{
	"version": "1",
	"moduleRoots": ["/absolute/path/to/Biology of Disease", "/absolute/path/to/Anatomy"],
	"openRouter": {
		"baseUrl": "https://openrouter.ai/api/v1",
		"completionTimeoutMs": 120000,
		"completionMaxRetries": 5
	},
	"elevenLabs": {
		"baseUrl": "https://api.elevenlabs.io",
		"languageCode": "eng",
		"costPerAudioHourUsd": 0.22
	},
	"currency": {
		"gbpPerUsd": 0.74
	},
	"modelIdCheck": {
		"exemptProviders": ["elevenlabs"]
	},
	"naming": {
		"modulePrefixes": ["BOD", "Biology of Disease", "ANA"]
	},
	"subtopicSplitting": {
		"panelSize": 18,
		"bar": 9,
		"sizeGateWords": 600
	},
	"grouping": {
		"panelSize": 9,
		"bar": 5
	},
	"batch": {
		"concurrency": 1
	},
	"stages": {
		"transcription": {
			"modelId": "elevenlabs/scribe_v2"
		},
		"initial-subtopic-splitting": {
			"modelId": "<FAST_LONG_CONTEXT_MODEL>",
			"concurrency": 3
		},
		"deepen-subtopic-splitting": {
			"modelId": "<FAST_LONG_CONTEXT_MODEL>",
			"concurrency": 6,
			"callConcurrency": 10
		},
		"retitle-subtopics": {
			"modelId": "<REASONING_MODEL>"
		},
		"group-into-topics": {
			"modelId": "<REASONING_MODEL>",
			"concurrency": 9,
			"sendGapSeconds": 0.5
		},
		"judge-lecture-title": {
			"modelId": "<REASONING_MODEL>"
		},
		"transcript-structuring": {
			"modelId": "<REASONING_MODEL>",
			"temperature": 0.2,
			"maxTokens": 8192
		},
		"transcript-verification": {
			"modelId": "<REASONING_MODEL>",
			"temperature": null,
			"maxTokens": null
		},
		"read-slides": {
			"modelId": "google/gemini-3.8-flash",
			"temperature": null,
			"maxTokens": null,
			"concurrency": 10
		},
		"place-slides": {
			"modelId": "<REASONING_MODEL>"
		},
		"synthesis": {
			"modelId": "<REASONING_MODEL>",
			"temperature": 0.3,
			"maxTokens": 16384
		},
		"qa-loop": {
			"modelId": "<REASONING_MODEL>",
			"temperature": 0.1,
			"maxTokens": 8192,
			"maxIterations": 3
		}
	},
	"finalOutput": {
		"language": "en-GB",
		"pandocEngine": "xelatex"
	}
}
