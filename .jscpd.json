{
	"threshold": 0,
	"reporters": ["console"],
	"absolute": true,
	"gitignore": true,
	"ignore": [
		"**/*.test.{ts,tsx,js,mjs}",
		"**/*.integration.test.{ts,tsx,js,mjs}",
		"**/fixtures.{ts,js,mjs}",
		"**/__fixtures__/**",
		"**/__snapshots__/**",
		"node_modules/**",
		".claude/**"
	],
	"pattern": "**/*.{ts,tsx,js,mjs}",
	"minTokens": 20,
	"minLines": 2,
	"format": ["typescript", "tsx", "javascript"]
}
