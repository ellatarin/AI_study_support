{
	"threshold": 0,
	"reporters": ["console"],
	"absolute": true,
	"gitignore": true,
	"ignore": [
		"**/*.test.{ts,tsx}",
		"**/*.integration.test.{ts,tsx}",
		"**/__fixtures__/**",
		"**/__snapshots__/**",
		"node_modules/**",
		"dist/**",
		".claude/**"
	],
	"pattern": "src/**/*.{ts,tsx}",
	"minTokens": 20,
	"minLines": 2,
	"format": ["typescript", "tsx"]
}
